# Copy to .env and fill in what you need: cp .env.sample .env
# Read by `docker compose`, by `uvicorn --env-file .env`, and by falae_cli.py.
# Variables already set in your shell take precedence over this file.

# --- Storage --------------------------------------------------------------
# Where MP3s go: "local" or "gcs". The Docker image defaults to "gcs".
FALAE_STORAGE=local
# Bucket used when FALAE_STORAGE=gcs.
FALAE_GCS_BUCKET=FILL_ME
# Directory used when FALAE_STORAGE=local. Ignored by compose.yaml, which writes to ./output.
FALAE_OUTPUT_DIR=output

# --- Access control (POST /synthesize) ------------------------------------
# Required value of the X-API-Key header. Unset = no key needed.
# Generate one with: openssl rand -base64 32
FALAE_API_KEY=
# Comma-separated IPs or CIDRs allowed to call the API. Unset = any IP.
FALAE_ALLOWED_IPS=

# --- Google Cloud credentials ---------------------------------------------
# Absolute path on this machine to a credentials JSON file (no ~):
# - a service account key (recommended for servers, see README "Google Cloud setup"), or
# - your own login: /Users/<you>/.config/gcloud/application_default_credentials.json
#   (created by `gcloud auth application-default login`).
# Used by the CLI and uvicorn. compose.yaml mounts this file into the container, and
# defaults to your gcloud login file when this is unset.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Docker Compose only --------------------------------------------------
# Host port the service is published on.
FALAE_PORT=8013
